# Required. The service refuses to start without it — see the header of src/http/server.ts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHIPMATE_API_SECRET=

PORT=8788

# Cognee — shipment memory. The service runs without it; memory calls degrade to empty
# and /health says reachable:false rather than pretending.
COGNEE_BASE_URL=https://tenant-xxxx.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_DATASET=araxys_shipments
# One timeout per operation: a write returns in under a second, a GRAPH_COMPLETION search
# runs a model over a graph traversal, and a cognify rebuilds the graph. A single 8s
# ceiling silently starved the last two.
COGNEE_WRITE_TIMEOUT_MS=15000
COGNEE_SEARCH_TIMEOUT_MS=60000
COGNEE_COGNIFY_TIMEOUT_MS=300000

# Claude, for call extraction.
ANTHROPIC_API_KEY=
# Opus, measured not assumed. On a real Tamil/English call Haiku read the quoted rate as
# 1,000 and Sonnet as 24,000; the agent said 4,200. See the note in callIntake.ts before
# changing this — a confidently wrong rate gets quoted to a customer.
CLAUDE_MODEL=claude-opus-5

# Gemini, for email reading. Two providers means two keys to rotate — email is the
# higher-volume, lower-stakes read and the desk already had a Gemini key.
GEMINI_API_KEY=
# gemini-3.8-flash returned 503 on every attempt on 18 Sep 2026; 3.5-flash answers.
GEMINI_MODEL=gemini-3.5-flash

# --- n8n Cloud -----------------------------------------------------------------
# Settings -> n8n API -> Create an API key. No trailing /api on the base URL.
N8N_BASE_URL=
N8N_API_KEY=

# Where n8n reaches THIS service. Must be public — n8n Cloud cannot see localhost.
# Baked into the workflows at import time, because n8n Cloud restricts $env and gates
# $vars behind a paid plan. See the note in README.md.
SHIPMATE_BASE=

# Money rail only. Leave blank until Paytm is configured.
PAYTM_MID=

# --- v1 CRM -------------------------------------------------------------------
# SHIPMATE reads v1's enquiries and writes the quoting pipeline beside them. The
# service_role key bypasses RLS, which is why it lives here and never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
